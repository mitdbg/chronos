= expected_timeout\n-    else:\n-        assert _timeout > 0.0\n+    assert cooldown_time <= _timeout <= cooldown_time + litellm.utils.JITTER\n+\n+\n+def test_immediate_failover_without_upstream_retry_after():\n+    model_list = [\n+        {\n+            \"model_name\": \"gpt-3.5-turbo\",\n+            \"litellm_params\": {\"model\": \"openai/gpt-4.1-mini\"},\n+        },\n+        {\n+            \"model_name\": \"gpt-3.5-turbo\",\n+            \"litellm_params\": {\"model\": \"openai/gpt-4.1-mini\"},\n+        },\n+    ]\n+    rate_limit_error = litellm.RateLimitError(\n+        message=\"rate limited without an upstream backoff\",\n+        llm_provider=\"openai\",\n+        model=\"gpt-4.1-mini\",\n+        response=httpx.Response(\n+            status_code=429,\n+            request=httpx.Request(method=\"POST\", url=\"https://example.com\"),\n+        ),\n+    )\n+    router = litellm.Router(model_list=model_list)\n+\n+    timeout = router._time_to_sleep_before_retry(\n+        e=rate_limit_error,\n+        remaining_retries=2,\n+        num_retries=2,\n+        healthy_deployments=[model_list[1]],\n+        all_deployments=model_list,\n+    )\n+\n+    assert timeout == 0\n*** End Patch\n"},"call_id":"call_M3pBiNi7KeyU0zslvfuNQjZ9","expected":{"exit_code":0,"status":"ok"},"kind":"patch","name":"apply_patch","record_type":"event","schema_version":1,"sequence":13,"timestamp":"2026-07-28T02:20:23.898Z"}
