flowchart TB
  Workspace["ChronosWorkspaceContext<br/>postgresql=..., duckdb=..., filesystem=..."]
  WSession["WorkspaceBranchSession"]
  PGSession["session.postgresql<br/>NativeBranchSession"]
  DuckSession["session.duckdb<br/>NativeBranchSession"]
  FSSession["session.filesystem / ChronosFS<br/>Native FS session"]

  Workspace --> WSession
  WSession --> PGSession
  WSession --> DuckSession
  WSession --> FSSession

  subgraph SharedMeta["Shared transactional metadata store"]
    B["branches"]
    S["segments"]
    CP["checkpoints"]
    R["registries"]
    C["branch transaction commits"]
  end

  subgraph PhysicalStores["Physical data stores"]
    PG["PostgreSQL physical interval tables"]
    Duck["DuckDB physical interval tables"]
    FS["ChronosFS interval tables"]
  end

  PGSession --> SharedMeta
  DuckSession --> SharedMeta
  FSSession --> SharedMeta

  PGSession --> PG
  DuckSession --> Duck
  FSSession --> FS

  SharedMeta -. "single branch lifecycle authority" .-> WSession
  WSession -. "merge_apply reserves merge + continuation<br/>then publishes one branch head" .-> C
